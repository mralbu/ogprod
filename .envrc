# Project environment: uv's .venv on PATH and fish completions.
watch_file pyproject.toml uv.lock

uv sync --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# direnv only exports environment variables and cannot change fish's
# fish_complete_path, so the script goes to the user's completions directory, which
# fish loads lazily on the first <Tab>. The script only calls the CLI itself, so
# outside the project (with the command not on PATH) it does nothing.
fish_completions="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
if command -v fish >/dev/null; then
  mkdir -p "$fish_completions"
  ogprod completion fish >"$fish_completions/ogprod.fish"
fi
